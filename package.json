{
  "name": "emote-api",
  "description": "An api that serves emotes.",
  "version": "2.0.0",
  "homepage": "https://github.com/devinleonhart/emote-generator",
  "repository": {
    "type": "git",
    "url": "git@github.com/devinleonhart/emote-generator.git"
  },
  "license": "MIT",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc --watch & wait-on dist/app.js && node dist/app.js",
    "dev:server": "tsc --watch & wait-on dist/app.js && nodemon dist/app.js",
    "lint": "eslint --ext .ts src",
    "start": "node ./dist/app.js"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "merge-images": "^2.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/merge-images": "^1.2.4",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "wait-on": "^9.0.10"
  },
  "type": "module"
}
