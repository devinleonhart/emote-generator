<div class="bb-container-lg">
  <%= turbo_frame_tag "generator" do %>
    <% if @characters.empty? %>
      <p class="bb-empty-state bb-empty-state__text">No characters</p>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6"
           data-controller="generator" data-generator-character-value="<%= @character %>" data-generator-path-value="<%= emote_path %>">
        <section class="bb-card bb-card--panel min-w-0 md:order-2 md:self-start text-center" aria-label="Preview">
          <h2 class="bb-section-heading--sm">Preview</h2>
          <div class="flex items-center justify-center min-h-50 mb-4">
            <p class="bb-subtitle" data-generator-target="empty">No emote selected</p>
            <img alt="Emote" class="max-w-full" width="157" height="150" hidden data-generator-target="image">
          </div>
          <button type="button" class="bb-btn bb-btn-primary disabled:opacity-50" disabled
                  data-generator-target="copy" data-action="generator#copy">Copy URL</button>
        </section>

        <section class="bb-card bb-card--panel min-w-0 md:order-1" aria-label="Options">
          <div class="relative mb-6" data-controller="dropdown" data-action="click@document->dropdown#closeOutside">
            <label for="character" class="bb-label">Character</label>
            <input id="character" type="text" class="bb-input pr-9 cursor-pointer" value="<%= @character.capitalize %>" autocomplete="off" spellcheck="false"
                   role="combobox" aria-expanded="false" aria-controls="characters" aria-autocomplete="list"
                   data-dropdown-target="input"
                   data-action="click->dropdown#open input->dropdown#filter keydown->dropdown#key blur->dropdown#leave">
            <span class="absolute right-3 bottom-2 pointer-events-none bb-subtitle" aria-hidden="true">&#9662;</span>
            <div class="absolute z-10 inset-x-0 mt-1 bb-card max-h-72 overflow-y-auto" hidden data-dropdown-target="menu">
              <div id="characters" role="listbox" aria-label="Characters">
                <% @characters.each do |character| %>
                  <%= link_to character.capitalize, root_path(character:), id: "character_#{character}", role: "option", tabindex: -1,
                              aria: { selected: character == @character }, data: { dropdown_target: "option" },
                              class: "block px-3 py-2 hover:bg-neutral-200 aria-selected:font-bold data-active:bg-neutral-200" %>
                <% end %>
              </div>
              <p class="bb-subtitle px-3 py-2" hidden data-dropdown-target="none">No characters match</p>
            </div>
          </div>

          <% @parts.each do |kind, names| %>
            <fieldset class="relative mb-5">
              <legend class="bb-subheading-sm"><%= kind.capitalize %></legend>
              <div class="flex flex-wrap gap-2">
                <% names.each do |name| %>
                  <label class="bb-btn-sm bb-btn-outline has-checked:bg-brand-600 has-checked:text-white has-focus-visible:ring-2 has-focus-visible:ring-brand-500">
                    <%= radio_button_tag kind, name, @chosen[kind] == name, autocomplete: "off", class: "sr-only",
                                         data: { generator_target: "part", action: "generator#draw" } %>
                    <%= name %>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% end %>
        </section>
      </div>
    <% end %>
  <% end %>
</div>
